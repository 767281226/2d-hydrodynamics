{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/triangle-domain-mesh-only-config-v1_1.schema.json",
  "title": "Restricted D minus S mesh-only generation config with explicit Gmsh algorithm plan",
  "description": "Schema 1.1 adds one required, versioned mesh_algorithm_plan. Schema 1.0 retains its frozen implicit Gmsh behavior.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "description": "Required lowercase SHA-256 hex digest."
    },
    "projectRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?![\\s\\S]*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|(?![\\s\\S])))[\\s\\S]+(?![\\s\\S])",
      "description": "Required project-relative path; absolute paths and parent traversal are rejected."
    },
    "statIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "mtime_ns": {
          "type": "integer",
          "minimum": 0
        },
        "ctime_ns": {
          "type": "integer",
          "minimum": 0
        },
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "file_id": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "size_bytes",
        "mtime_ns",
        "ctime_ns",
        "device",
        "file_id"
      ]
    },
    "meshGeneration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_faces": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500000,
          "description": "Required generated triangle cap, count."
        },
        "maximum_nodes": {
          "type": "integer",
          "minimum": 3,
          "maximum": 2000000,
          "description": "Required generated node cap, count."
        },
        "minimum_face_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Required normalized minimum face quality, unitless."
        },
        "geometry_tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Required geometry/line tolerance, m."
        },
        "minimum_face_area_m2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Required minimum triangle area, m2."
        },
        "default_size_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "description": "Required target default mesh size, m."
        },
        "minimum_size_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "description": "Required target minimum mesh size, m; must exceed geometry_tolerance_m and not exceed default_size_m."
        },
        "area_abs_tolerance_m2": {
          "type": "number",
          "minimum": 1e-12,
          "maximum": 1,
          "description": "Required absolute D-minus-S closure tolerance, m2."
        },
        "area_rel_tolerance": {
          "type": "number",
          "minimum": 1e-12,
          "maximum": 0.001,
          "description": "Required relative D-minus-S closure tolerance, unitless."
        }
      },
      "required": [
        "maximum_faces",
        "maximum_nodes",
        "minimum_face_quality",
        "geometry_tolerance_m",
        "minimum_face_area_m2",
        "default_size_m",
        "minimum_size_m",
        "area_abs_tolerance_m2",
        "area_rel_tolerance"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_workers": {
          "type": "integer",
          "const": 1,
          "description": "Fixed worker count, count."
        },
        "job_memory_limit_mib": {
          "type": "integer",
          "const": 2048,
          "description": "Fixed Job Object commit cap, MiB."
        },
        "wall_clock_limit_s": {
          "type": "number",
          "const": 900,
          "description": "Fixed worker-attempt wall cap, seconds."
        },
        "output_budget_bytes": {
          "type": "integer",
          "const": 1073741824,
          "description": "Fixed output cap, bytes."
        },
        "scratch_budget_bytes": {
          "type": "integer",
          "const": 16777216,
          "description": "Fixed private scratch cap, bytes."
        },
        "child_process_policy": {
          "type": "string",
          "const": "job_object_inheritance_without_breakaway"
        }
      },
      "required": [
        "max_workers",
        "job_memory_limit_mib",
        "wall_clock_limit_s",
        "output_budget_bytes",
        "scratch_budget_bytes",
        "child_process_policy"
      ]
    },
    "meshAlgorithmPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "const": "triangle-mesh-algorithm-plan-v1"
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "algorithm_2d": {
          "type": "integer",
          "enum": [
            5,
            6
          ],
          "description": "Required Gmsh SDK enum; unit 1 (dimensionless): 5=Delaunay, 6=Frontal-Delaunay. No default."
        },
        "smoothing": {
          "type": "integer",
          "const": 1,
          "description": "Required fixed Gmsh Mesh.Smoothing option, one smoothing pass. No default."
        },
        "algorithm_switch_on_failure": {
          "type": "integer",
          "const": 0,
          "description": "Required fixed Gmsh Mesh.AlgorithmSwitchOnFailure option. Disables hidden algorithm fallback. No default."
        },
        "optimizer": {
          "type": "string",
          "enum": [
            "none",
            "Relocate2D"
          ],
          "description": "Required post-generation operation. No default or fallback."
        },
        "iterations": {
          "type": "integer",
          "enum": [
            0,
            1
          ],
          "description": "Required iteration count; 0 for none and 1 for Relocate2D. No default."
        },
        "force": {
          "type": "boolean",
          "const": false,
          "description": "Fixed false so discrete entities are not force-optimized."
        },
        "entity_scope": {
          "type": "string",
          "const": "active_surface",
          "description": "The active surface tag is bound internally; callers cannot supply entity tags."
        }
      },
      "required": [
        "format",
        "schema_version",
        "algorithm_2d",
        "smoothing",
        "algorithm_switch_on_failure",
        "optimizer",
        "iterations",
        "force",
        "entity_scope"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "optimizer": {
                "const": "none"
              }
            },
            "required": [
              "optimizer"
            ]
          },
          "then": {
            "properties": {
              "iterations": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "optimizer": {
                "const": "Relocate2D"
              }
            },
            "required": [
              "optimizer"
            ]
          },
          "then": {
            "properties": {
              "iterations": {
                "const": 1
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "format": {
      "type": "string",
      "const": "triangle-domain-mesh-only-config-v1"
    },
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "output_root": {
      "$ref": "#/$defs/projectRelativePath"
    },
    "resources": {
      "$ref": "#/$defs/resources"
    },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/projectRelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_stat_identity": {
          "$ref": "#/$defs/statIdentity"
        }
      },
      "required": [
        "path",
        "sha256",
        "expected_stat_identity"
      ],
      "description": "Dispatcher-retained source-manifest path/hash/stat identity. Component geometry is never trusted from the output bundle."
    },
    "target_coordinate_system": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Required projected target CRS in metres; source CRS declarations are explicit in the source manifest."
    },
    "mesh_generation": {
      "$ref": "#/$defs/meshGeneration"
    },
    "expected_gmsh_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^4\\.(?:1[1-9]|[2-9][0-9]|[1-9][0-9]{2,})\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "description": "Required exact installed Gmsh version in canonical 4.minor.patch form, minor >= 11, without leading zeros or suffixes."
    },
    "expected_gmsh_library_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "mesh_algorithm_plan": {
      "$ref": "#/$defs/meshAlgorithmPlan"
    }
  },
  "required": [
    "format",
    "schema_version",
    "run_id",
    "output_root",
    "resources",
    "source_manifest",
    "target_coordinate_system",
    "mesh_generation",
    "expected_gmsh_version",
    "expected_gmsh_library_sha256",
    "mesh_algorithm_plan"
  ]
}
