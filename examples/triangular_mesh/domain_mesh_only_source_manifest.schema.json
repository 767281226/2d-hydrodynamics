{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/triangle-domain-mesh-only-source-manifest.schema.json",
  "title": "Trusted D/S/line component identity manifest",
  "description": "External dispatcher-retained identities for a bounded geometry-only mesh generation attempt. Component paths are relative to this manifest. Existing SHP sidecars are all declared; DBF/CPG bytes are identity-bound when present but their records are not read.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "manifestRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?![\\s\\S]*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|(?![\\s\\S])))[\\s\\S]+(?![\\s\\S])",
      "description": "Path relative to the source manifest directory; absolute paths and parent traversal are rejected."
    },
    "statIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size_bytes": {"type": "integer", "minimum": 0},
        "mtime_ns": {"type": "integer", "minimum": 0},
        "ctime_ns": {"type": "integer", "minimum": 0},
        "device": {"type": "integer", "minimum": 0},
        "file_id": {"type": "integer", "minimum": 0}
      },
      "required": ["size_bytes", "mtime_ns", "ctime_ns", "device", "file_id"]
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/manifestRelativePath", "description": "Path relative to the source manifest directory."},
        "sha256": {"$ref": "#/$defs/sha256"},
        "expected_stat_identity": {"$ref": "#/$defs/statIdentity"}
      },
      "required": ["path", "sha256", "expected_stat_identity"]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"},
        "role": {"enum": ["domain_D", "security_S", "boundary_line", "constraint_line"]},
        "format": {"enum": ["polygon_geojson", "polygon_shapefile", "line_geojson", "line_shapefile"]},
        "source_crs": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "geometry": {"$ref": "#/$defs/fileIdentity"},
            "shp": {"$ref": "#/$defs/fileIdentity"},
            "shx": {"$ref": "#/$defs/fileIdentity"},
            "prj": {"$ref": "#/$defs/fileIdentity"},
            "dbf": {"$ref": "#/$defs/fileIdentity"},
            "cpg": {"$ref": "#/$defs/fileIdentity"}
          }
        },
        "group_name": {"type": ["string", "null"], "minLength": 1},
        "closed": {"type": ["boolean", "null"]}
      },
      "required": ["component_id", "role", "format", "source_crs", "files", "group_name", "closed"],
      "allOf": [
        {
          "if": {"properties": {"format": {"const": "polygon_geojson"}}, "required": ["format"]},
          "then": {"properties": {"role": {"enum": ["domain_D", "security_S"]}, "files": {"required": ["geometry"], "minProperties": 1, "maxProperties": 1}, "group_name": {"const": null}, "closed": {"const": null}}}
        },
        {
          "if": {"properties": {"format": {"const": "polygon_shapefile"}}, "required": ["format"]},
          "then": {"properties": {"role": {"enum": ["domain_D", "security_S"]}, "files": {"required": ["shp", "shx", "prj"], "minProperties": 3, "maxProperties": 5}, "group_name": {"const": null}, "closed": {"const": null}}}
        },
        {
          "if": {"properties": {"format": {"const": "line_geojson"}}, "required": ["format"]},
          "then": {"properties": {"role": {"enum": ["boundary_line", "constraint_line"]}, "files": {"required": ["geometry"], "minProperties": 1, "maxProperties": 1}, "group_name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"}, "closed": {"type": "boolean"}}}
        },
        {
          "if": {"properties": {"format": {"const": "line_shapefile"}}, "required": ["format"]},
          "then": {"properties": {"role": {"enum": ["boundary_line", "constraint_line"]}, "files": {"required": ["shp", "shx", "prj"], "minProperties": 3, "maxProperties": 5}, "group_name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"}, "closed": {"type": "boolean"}}}
        },
        {
          "if": {"properties": {"role": {"const": "constraint_line"}}, "required": ["role"]},
          "then": {"properties": {"closed": {"const": false}}}
        }
      ]
    }
  },
  "properties": {
    "format": {"type": "string", "const": "triangle-domain-mesh-source-manifest-v1"},
    "schema_version": {"type": "string", "const": "1.0"},
    "source_set_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"},
    "target_coordinate_system": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/component"},
      "allOf": [
        {"contains": {"properties": {"role": {"const": "domain_D"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"role": {"const": "security_S"}}, "required": ["role"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"role": {"enum": ["boundary_line", "constraint_line"]}}, "required": ["role"]}, "minContains": 1}
      ],
      "description": "Exactly one D, exactly one S and at least one source boundary/constraint line. Current A adapter accepts one active D−S Polygon; multipart lines and active MultiPolygon are refused."
    }
  },
  "required": ["format", "schema_version", "source_set_id", "target_coordinate_system", "components"]
}
