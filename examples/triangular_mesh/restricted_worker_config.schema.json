{
  "$defs": {
    "projectRelativePath": {
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "windowedMappingConfig": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage_policy": {
                "const": "diagnostic_only"
              }
            }
          },
          "then": {
            "properties": {
              "coverage_policy_evidence_path": {
                "const": null
              },
              "coverage_policy_evidence_sha256": {
                "const": null
              },
              "minimum_valid_coverage": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage_policy": {
                "const": "minimum_valid_coverage"
              }
            }
          },
          "then": {
            "properties": {
              "coverage_policy_evidence_path": {
                "type": "string"
              },
              "coverage_policy_evidence_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "minimum_valid_coverage": {
                "type": "number"
              }
            },
            "required": [
              "minimum_valid_coverage",
              "coverage_policy_evidence_path",
              "coverage_policy_evidence_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_vertical_unit_declaration": {
                "const": "m"
              }
            },
            "required": [
              "source_vertical_unit_declaration"
            ]
          },
          "then": {
            "properties": {
              "source_vertical_unit_evidence_path": {
                "type": "string"
              },
              "source_vertical_unit_evidence_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "source_vertical_unit_evidence_path",
              "source_vertical_unit_evidence_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_vertical_datum_declaration": {
                "type": "string"
              }
            },
            "required": [
              "source_vertical_datum_declaration"
            ]
          },
          "then": {
            "properties": {
              "source_vertical_datum_evidence_path": {
                "type": "string"
              },
              "source_vertical_datum_evidence_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "source_vertical_datum_evidence_path",
              "source_vertical_datum_evidence_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_vertical_unit_evidence_path": {
                "type": "string"
              }
            },
            "required": [
              "source_vertical_unit_evidence_path"
            ]
          },
          "then": {
            "properties": {
              "source_vertical_unit_declaration": {
                "const": "m"
              }
            },
            "required": [
              "source_vertical_unit_declaration"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_vertical_unit_evidence_sha256": {
                "type": "string"
              }
            },
            "required": [
              "source_vertical_unit_evidence_sha256"
            ]
          },
          "then": {
            "properties": {
              "source_vertical_unit_declaration": {
                "const": "m"
              }
            },
            "required": [
              "source_vertical_unit_declaration"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_vertical_datum_evidence_path": {
                "type": "string"
              }
            },
            "required": [
              "source_vertical_datum_evidence_path"
            ]
          },
          "then": {
            "properties": {
              "source_vertical_datum_declaration": {
                "type": "string"
              }
            },
            "required": [
              "source_vertical_datum_declaration"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_vertical_datum_evidence_sha256": {
                "type": "string"
              }
            },
            "required": [
              "source_vertical_datum_evidence_sha256"
            ]
          },
          "then": {
            "properties": {
              "source_vertical_datum_declaration": {
                "type": "string"
              }
            },
            "required": [
              "source_vertical_datum_declaration"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coverage_policy_evidence_path": {
                "type": "string"
              }
            },
            "required": [
              "coverage_policy_evidence_path"
            ]
          },
          "then": {
            "required": [
              "coverage_policy_evidence_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coverage_policy_evidence_sha256": {
                "type": "string"
              }
            },
            "required": [
              "coverage_policy_evidence_sha256"
            ]
          },
          "then": {
            "required": [
              "coverage_policy_evidence_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_vertical_unit_evidence_path": {
                "type": "string"
              }
            },
            "required": [
              "source_vertical_unit_evidence_path"
            ]
          },
          "then": {
            "required": [
              "source_vertical_unit_evidence_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_vertical_unit_evidence_sha256": {
                "type": "string"
              }
            },
            "required": [
              "source_vertical_unit_evidence_sha256"
            ]
          },
          "then": {
            "required": [
              "source_vertical_unit_evidence_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_vertical_datum_evidence_path": {
                "type": "string"
              }
            },
            "required": [
              "source_vertical_datum_evidence_path"
            ]
          },
          "then": {
            "required": [
              "source_vertical_datum_evidence_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_vertical_datum_evidence_sha256": {
                "type": "string"
              }
            },
            "required": [
              "source_vertical_datum_evidence_sha256"
            ]
          },
          "then": {
            "required": [
              "source_vertical_datum_evidence_path"
            ]
          }
        }
      ],
      "properties": {
        "area_abs_tolerance_m2": {
          "default": 1e-08,
          "exclusiveMinimum": 0.0,
          "maximum": 0.001,
          "type": "number"
        },
        "area_rel_tolerance": {
          "default": 1e-10,
          "exclusiveMinimum": 0.0,
          "maximum": 1e-06,
          "type": "number"
        },
        "coverage_policy": {
          "description": "Required. diagnostic_only never marks engineering terrain ready.",
          "enum": [
            "diagnostic_only",
            "minimum_valid_coverage"
          ],
          "type": "string"
        },
        "coverage_policy_evidence_path": {
          "default": null,
          "description": "Relative path to the source-approved coverage policy.",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+",
          "type": [
            "string",
            "null"
          ]
        },
        "coverage_policy_evidence_sha256": {
          "default": null,
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "elevation_abs_tolerance_m": {
          "default": 1e-08,
          "exclusiveMinimum": 0.0,
          "maximum": 0.001,
          "type": "number"
        },
        "elevation_rel_tolerance": {
          "default": 1e-10,
          "exclusiveMinimum": 0.0,
          "maximum": 1e-06,
          "type": "number"
        },
        "format": {
          "const": "triangle-terrain-windowed-v1",
          "default": "triangle-terrain-windowed-v1",
          "type": "string"
        },
        "gdal_cache_mib": {
          "const": 64,
          "default": 64,
          "type": "integer"
        },
        "max_candidate_overlap_checks": {
          "description": "Required cap on candidate face/pixel clip checks; fail before the first over-budget clip.",
          "maximum": 1000000000,
          "minimum": 1,
          "type": "integer"
        },
        "max_faces": {
          "default": 500000,
          "maximum": 500000,
          "minimum": 1,
          "type": "integer"
        },
        "max_inflight_tiles": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "max_nodes": {
          "default": 2000000,
          "maximum": 2000000,
          "minimum": 3,
          "type": "integer"
        },
        "max_source_pixels": {
          "description": "Maximum raster identity/scan size, pixels; not an in-memory array dimension.",
          "maximum": 1000000000,
          "minimum": 1,
          "type": "integer"
        },
        "minimum_valid_coverage": {
          "default": null,
          "description": "Source-approved valid-area/face-area threshold. Required only for minimum_valid_coverage policy.",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "source_vertical_datum_declaration": {
          "default": null,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "source_vertical_datum_evidence_path": {
          "default": null,
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+",
          "type": [
            "string",
            "null"
          ]
        },
        "source_vertical_datum_evidence_sha256": {
          "default": null,
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "source_vertical_unit_declaration": {
          "anyOf": [
            {
              "const": "m",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_vertical_unit_evidence_path": {
          "default": null,
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+",
          "type": [
            "string",
            "null"
          ]
        },
        "source_vertical_unit_evidence_sha256": {
          "default": null,
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "tile_cols": {
          "default": 256,
          "description": "Raw source tile columns, pixels; tile_rows*tile_cols must be <=65536.",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "tile_rows": {
          "default": 256,
          "description": "Raw source tile rows, pixels.",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_source_pixels",
        "max_candidate_overlap_checks",
        "coverage_policy"
      ],
      "type": "object"
    }
  },
  "$id": "triangle-terrain-preparation-worker-config-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "crs_alias": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "description": "Preparation-only alias after runtime verification of authority, axis/unit, projection, datum, ellipsoid and bound transformation. No coordinate reordering or transform occurs.",
          "properties": {
            "expected_source_wkt_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "mode": {
              "const": "verify_embedded_epsg4548_xy",
              "type": "string"
            },
            "target_crs": {
              "const": "EPSG:4548",
              "type": "string"
            }
          },
          "required": [
            "mode",
            "target_crs",
            "expected_source_wkt_sha256"
          ],
          "type": "object"
        }
      ]
    },
    "format": {
      "const": "triangle-terrain-preparation-worker-config-v1",
      "type": "string"
    },
    "mapping_config": {
      "$ref": "#/$defs/windowedMappingConfig"
    },
    "mesh": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/projectRelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "output_root": {
      "$ref": "#/$defs/projectRelativePath"
    },
    "resources": {
      "additionalProperties": false,
      "properties": {
        "child_process_policy": {
          "const": "job_object_inheritance_without_breakaway",
          "type": "string"
        },
        "job_memory_limit_mib": {
          "description": "Required OS-enforced aggregate Windows Job Object commit limit, MiB.",
          "maximum": 65536,
          "minimum": 64,
          "type": "integer"
        },
        "max_workers": {
          "const": 1,
          "description": "Fixed at one worker for B0.",
          "type": "integer"
        },
        "output_budget_bytes": {
          "description": "Required cap for worker artifacts, status, manifest and markers, bytes.",
          "maximum": 9223372036854775807,
          "minimum": 131072,
          "type": "integer"
        },
        "scratch_budget_bytes": {
          "description": "Required cap for the isolated scratch/temp tree, bytes.",
          "maximum": 9223372036854775807,
          "minimum": 65536,
          "type": "integer"
        },
        "wall_clock_limit_s": {
          "description": "Required finite total worker-tree and prepared-readback wall limit, seconds.",
          "maximum": 86400,
          "minimum": 0.1,
          "type": "number"
        }
      },
      "required": [
        "max_workers",
        "job_memory_limit_mib",
        "wall_clock_limit_s",
        "output_budget_bytes",
        "scratch_budget_bytes",
        "child_process_policy"
      ],
      "type": "object"
    },
    "run_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "$ref": "#/$defs/projectRelativePath"
              },
              "required": {
                "type": "boolean"
              },
              "role": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "required": [
              "role",
              "path",
              "sha256",
              "required"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "expected_stat_identity": {
          "description": "Frozen current stat identity; null is used only when a case generator captures it at launch.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "ctime_ns": {
                  "minimum": 0,
                  "type": "integer"
                },
                "device": {
                  "minimum": 0,
                  "type": "integer"
                },
                "file_id": {
                  "minimum": 0,
                  "type": "integer"
                },
                "mtime_ns": {
                  "minimum": 0,
                  "type": "integer"
                },
                "size_bytes": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "size_bytes",
                "mtime_ns",
                "ctime_ns",
                "device",
                "file_id"
              ],
              "type": "object"
            }
          ]
        },
        "raster_path": {
          "$ref": "#/$defs/projectRelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_manifest_path": {
          "$ref": "#/$defs/projectRelativePath"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "raster_path",
        "sha256",
        "source_manifest_path",
        "source_manifest_sha256",
        "expected_stat_identity",
        "components"
      ],
      "type": "object"
    }
  },
  "required": [
    "format",
    "schema_version",
    "run_id",
    "output_root",
    "resources",
    "source",
    "mesh",
    "mapping_config",
    "crs_alias"
  ],
  "title": "Restricted windowed terrain preparation worker configuration",
  "type": "object"
}
