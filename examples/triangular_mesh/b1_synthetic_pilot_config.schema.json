            "string",
            "null"
          ]
        },
        "source_vertical_datum_evidence_sha256": {
          "default": null,
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "source_vertical_unit_declaration": {
          "anyOf": [
            {
              "const": "m",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_vertical_unit_evidence_path": {
          "default": null,
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+",
          "type": [
            "string",
            "null"
          ]
        },
        "source_vertical_unit_evidence_sha256": {
          "default": null,
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "tile_cols": {
          "default": 256,
          "description": "Raw source tile columns, pixels; tile_rows*tile_cols must be <=65536.",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        },
        "tile_rows": {
          "default": 256,
          "description": "Raw source tile rows, pixels.",
          "maximum": 256,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_source_pixels",
        "max_candidate_overlap_checks",
        "coverage_policy"
      ],
      "type": "object"
    },
    "pilotCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Stable unique identifier for this synthetic measurement, no default."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Fixed pseudorandom diagonal-selection seed, unitless integer [0, 2^32-1]."
        },
        "face_count": {
          "enum": [
            2,
            8,
            32
          ],
          "type": "integer",
          "description": "Required P0 triangle count, count; one of 2, 8 or 32."
        },
        "face_size_m": {
          "const": 50.0,
          "type": "number",
          "description": "Required nominal edge length, m; frozen at exactly 50 m."
        },
        "repeat_index": {
          "enum": [
            1,
            2
          ],
          "type": "integer",
          "description": "Independent worker launch index; repeat 1 and 2 use identical source/mesh identities."
        },
        "source_pattern": {
          "enum": [
            "planar_all_valid",
            "planar_nodata_nonfinite"
          ],
          "type": "string",
          "description": "Synthetic float32 source pattern; no real DEM pixels are accepted by the pilot example."
        }
      },
      "required": [
        "case_id",
        "seed",
        "face_count",
        "face_size_m",
        "repeat_index",
        "source_pattern"
      ]
    },
    "gmshGeneration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "triangle-b1-gmsh-generation-v1",
          "type": "string"
        },
        "maximum_faces": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500000,
          "description": "Required maximum generated triangle count, count; cannot exceed the B0 500000-face cap."
        },
        "maximum_nodes": {
          "type": "integer",
          "minimum": 3,
          "maximum": 2000000,
          "description": "Required maximum generated node count, count; cannot exceed the B0 2000000-node cap."
        },
        "minimum_face_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Required normalized triangle-quality lower bound, unitless [0,1]."
        },
        "area_abs_tolerance_m2": {
          "type": "number",
          "minimum": 1e-12,
          "maximum": 1,
          "description": "Required absolute outer-minus-hole area closure tolerance, m2; inclusive range [1e-12, 1]."
        },
        "area_rel_tolerance": {
          "type": "number",
          "minimum": 1e-12,
          "maximum": 0.001,
          "description": "Required relative outer-minus-hole area closure tolerance, unitless; inclusive range [1e-12, 1e-3]."
        },
        "expected_gmsh_version": {
          "type": "string",
          "minLength": 1,
          "description": "Required exact installed Gmsh version as canonical major.minor.patch decimal components with no leading zeros or suffix; major must be 4 and minor at least 11.",
          "pattern": "^4\\.(?:1[1-9]|[2-9][0-9]|[1-9][0-9]{2,})\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "expected_gmsh_library_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Required SHA-256 of the matching native Gmsh SDK library, measured before dispatch and rechecked inside the Job."
        },
        "area_roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "outer_boundary": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "holes": {
              "type": "object",
              "propertyNames": {
                "pattern": "^hole_[0-9]+(?![\\s\\S])"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "constraints": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "required": [
            "outer_boundary",
            "holes",
            "constraints"
          ],
          "description": "Required synthetic semantic roles. Names do not assert real D/S geometry or assign physical boundary conditions."
        }
      },
      "required": [
        "format",
        "maximum_faces",
        "maximum_nodes",
        "minimum_face_quality",
        "area_abs_tolerance_m2",
        "area_rel_tolerance",
        "expected_gmsh_version",
        "expected_gmsh_library_sha256",
        "area_roles"
      ]
    },
