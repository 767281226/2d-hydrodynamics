          "exclusiveMinimum": 0.0,
          "maximum": 1e-06,
          "type": "number"
        },
        "format": {
          "const": "triangle-terrain-windowed-v1",
          "default": "triangle-terrain-windowed-v1",
          "type": "string"
        },
        "gdal_cache_mib": {
          "const": 64,
          "default": 64,
          "type": "integer"
        },
        "max_candidate_overlap_checks": {
          "description": "Required cap on candidate face/pixel clip checks; fail before the first over-budget clip.",
          "maximum": 1000000000,
          "minimum": 1,
          "type": "integer"
        },
        "max_faces": {
          "default": 500000,
          "maximum": 500000,
          "minimum": 1,
          "type": "integer"
        },
        "max_inflight_tiles": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "max_nodes": {
          "default": 2000000,
          "maximum": 2000000,
          "minimum": 3,
          "type": "integer"
        },
        "max_source_pixels": {
          "description": "Maximum raster identity/scan size, pixels; not an in-memory array dimension.",
          "maximum": 1000000000,
          "minimum": 1,
          "type": "integer"
        },
        "minimum_valid_coverage": {
          "default": null,
          "description": "Source-approved valid-area/face-area threshold. Required only for minimum_valid_coverage policy.",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "source_vertical_datum_declaration": {
          "default": null,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "source_vertical_datum_evidence_path": {
          "default": null,
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+",
