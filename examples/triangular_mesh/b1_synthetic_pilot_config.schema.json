          "default": 1e-10,
          "exclusiveMinimum": 0.0,
          "maximum": 1e-06,
          "type": "number"
        },
        "coverage_policy": {
          "description": "Required. diagnostic_only never marks engineering terrain ready.",
          "enum": [
            "diagnostic_only",
            "minimum_valid_coverage"
          ],
          "type": "string"
        },
        "coverage_policy_evidence_path": {
          "default": null,
          "description": "Relative path to the source-approved coverage policy.",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+",
          "type": [
            "string",
            "null"
          ]
        },
