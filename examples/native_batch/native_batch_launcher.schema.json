{
  "format": "native-batch-launcher-schema-set-v1",
  "synthetic_launch_config_schema": {
    "additionalProperties": false,
    "properties": {
      "format": {
        "const": "native-batch-launch-config-v1",
        "title": "Format",
        "type": "string"
      },
      "schema_version": {
        "const": "1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "mode": {
        "const": "synthetic_demo",
        "title": "Mode",
        "type": "string"
      },
      "data_origin": {
        "const": "SYNTHETIC_ONLY",
        "title": "Data Origin",
        "type": "string"
      },
      "case_id": {
        "const": "security-exclusion-synthetic-dynamic-v1",
        "title": "Case Id",
        "type": "string"
      },
      "source_case_directory": {
        "description": "Project-relative profile directory; this launcher currently accepts examples/security_exclusion",
        "title": "Source Case Directory",
        "type": "string"
      },
      "maximum_face_count": {
        "default": 64,
        "description": "Maximum active triangular faces, count",
        "maximum": 64,
        "minimum": 1,
        "title": "Maximum Face Count",
        "type": "integer"
      },
      "maximum_saved_frame_count": {
        "default": 8,
        "description": "Maximum native saved frames, count",
        "maximum": 8,
        "minimum": 2,
        "title": "Maximum Saved Frame Count",
        "type": "integer"
      },
      "maximum_duration_s": {
        "default": 1.0,
        "description": "Maximum synthetic run duration, seconds",
        "exclusiveMinimum": 0.0,
        "maximum": 1.0,
        "title": "Maximum Duration S",
        "type": "number"
      }
    },
    "required": [
      "format",
      "schema_version",
      "mode",
      "data_origin",
      "case_id",
      "source_case_directory"
    ],
    "title": "NativeBatchLaunchConfig",
    "type": "object"
  },
  "engineering_preflight_config_schema": {
