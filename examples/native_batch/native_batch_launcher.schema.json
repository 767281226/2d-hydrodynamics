  "run_report_schema": {
    "$defs": {
      "NativeBatchBlocker": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "next_action": {
            "title": "Next Action",
            "type": "string"
          }
        },
        "required": [
          "code",
          "field",
          "message",
          "next_action"
        ],
        "title": "NativeBatchBlocker",
        "type": "object"
      },
      "NativeBatchCopiedInput": {
        "additionalProperties": false,
        "properties": {
          "relative_path": {
            "title": "Relative Path",
            "type": "string"
          },
          "byte_count": {
            "minimum": 0,
            "title": "Byte Count",
            "type": "integer"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "relative_path",
          "byte_count",
          "sha256"
        ],
        "title": "NativeBatchCopiedInput",
        "type": "object"
      },
      "NativeBatchInputPathCheck": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "exists": {
            "title": "Exists",
            "type": "boolean"
          },
          "content_read": {
            "const": false,
            "default": false,
            "title": "Content Read",
            "type": "boolean"
          }
        },
        "required": [
          "field",
          "path",
          "exists"
        ],
        "title": "NativeBatchInputPathCheck",
        "type": "object"
      },
      "NativeBatchStageReport": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "script_id": {
            "title": "Script Id",
            "type": "string"
          },
          "data_origin": {
            "enum": [
              "SYNTHETIC_ONLY",
              "ENGINEERING_PRECHECK"
            ],
            "title": "Data Origin",
            "type": "string"
          },
          "status": {
            "enum": [
              "complete",
              "failed",
              "blocked"
            ],
            "title": "Status",
            "type": "string"
          },
          "command": {
            "items": {
              "type": "string"
            },
            "title": "Command",
            "type": "array"
          },
          "started_at": {
            "title": "Started At",
            "type": "string"
          },
          "finished_at": {
            "title": "Finished At",
            "type": "string"
          },
          "elapsed_seconds": {
            "minimum": 0.0,
            "title": "Elapsed Seconds",
            "type": "number"
          },
          "exit_code": {
            "title": "Exit Code",
            "type": "integer"
          },
          "stdout_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stdout File"
          },
          "stderr_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stderr File"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error"
          }
        },
        "required": [
          "name",
          "script_id",
          "data_origin",
          "status",
          "command",
          "started_at",
          "finished_at",
          "elapsed_seconds",
          "exit_code"
        ],
        "title": "NativeBatchStageReport",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "format": {
        "const": "native-batch-run-report-v1",
        "title": "Format",
        "type": "string"
      },
      "schema_version": {
        "const": "1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "mode": {
        "enum": [
          "synthetic_demo",
          "engineering_preflight"
        ],
        "title": "Mode",
        "type": "string"
      },
      "data_origin": {
        "enum": [
          "SYNTHETIC_ONLY",
          "ENGINEERING_PRECHECK"
        ],
        "title": "Data Origin",
        "type": "string"
      },
      "engine_mode": {
        "enum": [
          "triangular_source_experimental",
          "native_triangular_engineering_preflight"
        ],
        "title": "Engine Mode",
        "type": "string"
      },
      "grid_topology": {
        "const": "native_triangular_mesh",
        "title": "Grid Topology",
        "type": "string"
      },
      "case_id": {
        "title": "Case Id",
        "type": "string"
      },
      "script_id": {
        "title": "Script Id",
        "type": "string"
      },
      "status": {
        "enum": [
          "running",
          "complete",
          "failed",
          "blocked"
        ],
        "title": "Status",
        "type": "string"
      },
      "preflight_only": {
        "title": "Preflight Only",
        "type": "boolean"
      },
      "execution_available": {
        "title": "Execution Available",
        "type": "boolean"
      },
      "started_at": {
        "title": "Started At",
        "type": "string"
      },
      "finished_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Finished At"
      },
      "elapsed_seconds": {
        "anyOf": [
          {
            "ge": 0.0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Elapsed Seconds"
      },
      "project_root": {
        "title": "Project Root",
        "type": "string"
      },
      "output_directory": {
        "title": "Output Directory",
        "type": "string"
      },
      "report_file": {
        "title": "Report File",
        "type": "string"
      },
      "python_executable": {
        "title": "Python Executable",
        "type": "string"
      },
      "module_source": {
        "title": "Module Source",
        "type": "string"
      },
      "package_version": {
        "title": "Package Version",
        "type": "string"
      },
      "launch_config_file": {
        "title": "Launch Config File",
        "type": "string"
      },
      "copied_inputs": {
        "items": {
          "$ref": "#/$defs/NativeBatchCopiedInput"
        },
        "title": "Copied Inputs",
        "type": "array"
      },
      "input_path_checks": {
        "items": {
          "$ref": "#/$defs/NativeBatchInputPathCheck"
        },
        "title": "Input Path Checks",
        "type": "array"
      },
      "stages": {
        "items": {
          "$ref": "#/$defs/NativeBatchStageReport"
        },
        "title": "Stages",
        "type": "array"
      },
      "blockers": {
        "items": {
          "$ref": "#/$defs/NativeBatchBlocker"
        },
        "title": "Blockers",
        "type": "array"
      },
      "output_files": {
        "items": {
          "type": "string"
        },
        "title": "Output Files",
        "type": "array"
      },
      "failed_stage": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Failed Stage"
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Error"
      }
    },
    "required": [
      "format",
      "schema_version",
      "mode",
      "data_origin",
      "engine_mode",
      "grid_topology",
      "case_id",
      "script_id",
      "status",
      "preflight_only",
      "execution_available",
      "started_at",
      "project_root",
      "output_directory",
      "report_file",
      "python_executable",
      "module_source",
      "package_version",
      "launch_config_file"
    ],
    "title": "NativeBatchRunReport",
    "type": "object"
  }
}
