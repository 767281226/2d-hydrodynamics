          "time_origin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Time Origin"
          },
          "time_unit": {
            "anyOf": [
              {
                "const": "s",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Time Unit"
          },
          "discharge_unit": {
            "anyOf": [
              {
                "const": "m3/s",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Discharge Unit"
          },
          "vertical_datum": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Vertical Datum"
          }
        },
        "title": "NativeEngineeringBoundary",
        "type": "object"
      },
      "NativeEngineeringInitialCondition": {
        "additionalProperties": false,
        "properties": {
          "source_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source File"
          },
          "quantity": {
            "anyOf": [
              {
                "enum": [
                  "depth",
                  "level"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quantity"
          },
          "unit": {
            "anyOf": [
              {
                "const": "m",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Unit"
          },
          "vertical_datum": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Vertical Datum"
          }
        },
        "title": "NativeEngineeringInitialCondition",
        "type": "object"
      },
      "NativeEngineeringRainfall": {
        "additionalProperties": false,
        "properties": {
          "source_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source File"
          },
          "input_unit": {
            "anyOf": [
              {
                "enum": [
                  "mm/h",
                  "m/s"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Input Unit"
          },
          "intervals_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Intervals File"
          }
        },
        "title": "NativeEngineeringRainfall",
        "type": "object"
      },
      "NativeEngineeringRoughness": {
        "additionalProperties": false,
        "properties": {
          "source_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source File"
          },
          "source_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Unit"
          },
          "physical_unit": {
            "anyOf": [
              {
                "const": "s/m^(1/3)",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Physical Unit"
          },
          "interpretation_policy": {
            "anyOf": [
              {
                "const": "legacy_unit1_as_si_manning",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Interpretation Policy"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rationale"
          }
        },
        "title": "NativeEngineeringRoughness",
        "type": "object"
      },
      "SecurityExclusionInput": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "const": "security-area-exclusion-v1",
            "title": "Format",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "source_file": {
            "description": "Relative path to the source Polygon/MultiPolygon SHP or GeoJSON; DBF attributes are not used",
            "title": "Source File",
            "type": "string"
          },
          "source_crs": {
            "description": "Explicit source CRS; must agree with SHP PRJ when the source is a Shapefile",
            "title": "Source Crs",
            "type": "string"
          },
          "constraint": {
            "const": "excluded_closed_wall",
            "title": "Constraint",
            "type": "string"
          },
          "domain_geometry_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required for imported P2 meshes: source Polygon/MultiPolygon geometry D",
            "title": "Domain Geometry File"
          },
          "domain_crs": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Explicit CRS of domain_geometry_file; no CRS is inferred",
            "title": "Domain Crs"
          }
        },
        "required": [
          "format",
          "schema_version",
          "enabled",
          "source_file",
          "source_crs",
          "constraint"
        ],
        "title": "SecurityExclusionInput",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Twenty explicit native-engineering evidence fields; this model never authorizes execution.",
    "properties": {
      "format": {
        "const": "native-engineering-preflight-v1",
