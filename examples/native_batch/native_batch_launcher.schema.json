          },
          "outflow_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Outflow File"
          },
          "group_mapping_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
