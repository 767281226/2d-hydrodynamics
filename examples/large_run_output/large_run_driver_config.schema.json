{
  "$defs": {
    "ForcingSection": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "CSV with time_s and the discharge series columns named by the audit",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "rainfall": {
          "default": null,
          "description": "must be null in v1 (no rainfall); a rainfall column contract is reserved for a later version",
          "title": "Rainfall",
          "type": "null"
        }
      },
      "required": [
        "path"
      ],
      "title": "ForcingSection",
      "type": "object"
    },
    "MeshSection": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "triangle-domain-mesh-only-artifact-v1 JSON",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "refuse the artifact if its SHA-256 differs",
          "title": "Expected Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "MeshSection",
      "type": "object"
    },
    "OutflowBoundarySettings": {
      "additionalProperties": false,
      "description": "How one audit outflow section leaves the domain.",
      "properties": {
        "boundary_type": {
          "default": "prescribed_outflow",
          "description": "prescribed_outflow: the CSV column is the applied Q(t); free_outflow: stage-dependent critical-flow weir outflow, the CSV column is only a reference series in the ledger",
          "enum": [
            "prescribed_outflow",
            "free_outflow"
          ],
          "title": "Boundary Type",
          "type": "string"
        },
        "discharge_coefficient": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ],
              "gt": 0.0,
              "le": 1.5
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "free_outflow only; dimensionless C_d in (0, 1.5]; null = (2/3)^(3/2) ~= 0.5443",
          "title": "Discharge Coefficient"
        },
        "crest_elevation_m": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ],
              "ge": -1000.0,
              "le": 10000.0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "free_outflow only; m, bed datum, [-1000, 10000]; null = bed of each adjacent face (head = depth)",
          "title": "Crest Elevation M"
        }
      },
      "title": "OutflowBoundarySettings",
      "type": "object"
    },
    "OutputSection": {
      "additionalProperties": false,
      "properties": {
        "directory": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "explicit run directory (exclusive with root); must not exist unless --resume; bundle is written to <directory>/bundle",
          "title": "Directory"
        },
        "root": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "results root (exclusive with directory), e.g. work/results; the run directory is <root>/<scheme id>",
          "title": "Root"
        },
        "script_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "scheme id = run directory name under root: 1-96 ASCII letters/digits/._-, starting with a letter or digit, no Windows reserved names; CLI --id wins; null with root = Beijing date + '-' + Unix ns (as the workflow)",
          "title": "Script Id"
        },
        "profile": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "LargeRunOutputProfile fields, or a YAML/JSON profile path; null = defaults",
          "title": "Profile"
        },
        "export": {
          "default": true,
          "description": "run export_large_run_bundle + verify_large_run_bundle after the solver",
          "title": "Export",
          "type": "boolean"
        }
      },
      "title": "OutputSection",
      "type": "object"
    },
    "RunSection": {
      "additionalProperties": false,
      "properties": {
        "hours": {
          "anyOf": [
            {
              "maximum": 8760,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "hourly output times 0..hours (exclusive with output_times_s)",
          "title": "Hours"
        },
        "output_times_s": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "maxItems": 100000,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "s; explicit output times starting at 0",
          "title": "Output Times S"
        },
        "initial_depth_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "description": "m; uniform initial water depth",
          "ge": 0.0,
          "le": 1000.0,
          "title": "Initial Depth M"
        },
        "manning_n": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "description": "s m^-1/3; uniform Manning n",
          "gt": 0.0,
          "le": 1.0,
          "title": "Manning N"
        },
        "long_run_options": {
          "additionalProperties": true,
          "description": "triangular-long-run-options-v1 fields (checkpoint_interval_s lives in run.checkpoint_interval_s)",
          "title": "Long Run Options",
          "type": "object"
        },
        "checkpoint_interval_s": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ],
              "gt": 0.0,
              "le": 31536000.0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "s; null disables checkpoints and therefore --resume",
          "title": "Checkpoint Interval S"
        },
        "time_origin": {
          "description": "ISO 8601 with explicit UTC offset, e.g. 2023-08-01T02:00:00+08:00",
          "title": "Time Origin",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "result run id shown in the bundle/viewer; null = the scheme id (output.script_id / --id)",
          "title": "Run Id"
        },
        "case_id": {
          "description": "also names the derived <case_id>.nc",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "coordinate_system": {
          "description": "must equal the mesh artifact coordinate_system",
          "minLength": 1,
          "title": "Coordinate System",
          "type": "string"
        }
      },
      "required": [
        "initial_depth_m",
        "manning_n",
        "time_origin",
        "case_id",
        "coordinate_system"
      ],
      "title": "RunSection",
      "type": "object"
    },
    "SectionsSection": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "assumed-river-sections-audit-v1 JSON",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "discharge_series_status": {
          "additionalProperties": {
            "enum": [
              "RECONSTRUCTED_NOT_MEASURED",
              "MEASURED",
              "COMPUTED_OUTFLOW"
            ],
            "type": "string"
          },
          "description": "one entry per section key in the audit",
          "title": "Discharge Series Status",
          "type": "object"
        },
        "distribution": {
          "additionalProperties": {
            "enum": [
              "length",
              "conveyance_depth_5_3"
            ],
            "type": "string"
          },
          "description": "per section; default inflow=length, prescribed outflow=conveyance_depth_5_3; not allowed for free_outflow sections",
          "title": "Distribution",
          "type": "object"
        },
        "outflow_boundary": {
          "additionalProperties": {
            "$ref": "#/$defs/OutflowBoundarySettings"
          },
          "description": "per outflow section; default boundary_type prescribed_outflow",
          "title": "Outflow Boundary",
          "type": "object"
        }
      },
      "required": [
        "path",
        "discharge_series_status"
      ],
      "title": "SectionsSection",
      "type": "object"
    },
    "TerrainSection": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": ".npz with int64 face_id and float64 elevation_m (matched by face_id)",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "dem_path": {
          "description": "provenance only; the driver never opens the DEM",
          "minLength": 1,
          "title": "Dem Path",
          "type": "string"
        },
        "dem_sha256": {
          "description": "provenance only; recorded as supplied",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dem Sha256",
          "type": "string"
        },
        "mapping_report_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "provenance only; hashed when present",
          "title": "Mapping Report Path"
        },
        "method": {
          "description": "free-text label of the terrain mapping method",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "vertical_datum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null: water levels are labelled unavailable in derived outputs",
          "title": "Vertical Datum"
        },
        "vertical_unit": {
          "const": "m",
          "default": "m",
          "title": "Vertical Unit",
          "type": "string"
        }
      },
      "required": [
        "path",
        "dem_path",
        "dem_sha256",
        "method"
      ],
      "title": "TerrainSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "large-run-driver-config-v1",
      "default": "large-run-driver-config-v1",
      "title": "Format",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "mesh": {
      "$ref": "#/$defs/MeshSection"
    },
    "terrain": {
      "$ref": "#/$defs/TerrainSection"
    },
    "sections": {
      "$ref": "#/$defs/SectionsSection"
    },
    "forcing": {
      "$ref": "#/$defs/ForcingSection"
    },
    "run": {
      "$ref": "#/$defs/RunSection"
    },
    "output": {
      "$ref": "#/$defs/OutputSection"
    }
  },
  "required": [
    "mesh",
    "terrain",
    "sections",
    "forcing",
    "run",
    "output"
  ],
  "title": "LargeRunDriverConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "large-run-driver-config-v1"
}
