{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native-triangle-web-manifest-v2.0",
  "title": "native_web/manifest.json for large-run bundles (one binary file per saved frame)",
  "type": "object",
  "required": ["format", "version", "status", "run_id", "topology", "coordinate_system", "time_origin", "times_s",
               "dry_depth_threshold_m", "node_count", "face_count", "extent_m", "forcing", "face_id_sha256", "mesh_file",
               "value_dtype", "variables", "extrema", "frame_magic", "frame_header", "frames", "data_origin"],
  "properties": {
    "format": {"const": "native-triangle-web"},
    "version": {"const": "2.0"},
    "status": {"const": "complete"},
    "run_id": {"type": "string", "minLength": 1},
    "topology": {"const": "native_triangular_mesh"},
    "data_origin": {"enum": ["LIVE_SOLVER_RUN", "SYNTHETIC_TEST_FIELDS"]},
    "times_s": {"type": "array", "items": {"type": "number"}, "minItems": 1},
    "value_dtype": {"enum": ["float32-le", "float64-le"]},
    "frame_magic": {"const": "NTW3F02\n"},
    "extent_m": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "forcing": {"type": "object", "required": ["scope", "notice", "rainfall_included", "river_inflow_outflow_included"]},
    "mesh_file": {"type": "object", "required": ["name", "sha256", "bytes", "layout"], "properties": {"name": {"const": "mesh.bin"}}},
    "variables": {"type": "array", "minItems": 5, "maxItems": 5,
                  "items": {"type": "object", "required": ["name", "dtype", "units", "availability"]}},
    "frames": {"type": "array", "minItems": 1,
               "items": {"type": "object", "required": ["index", "time_s", "file", "sha256", "bytes"],
                         "properties": {"file": {"type": "string", "pattern": "^frame_[0-9]{6}\\.bin$"}}}}
  }
}
