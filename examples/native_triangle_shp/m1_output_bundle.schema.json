{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m1-output-bundle-v1",
  "title": "M1 small native output QA bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "run_id", "case_id", "status", "data_origin", "qa_fixture", "live_solver_ran", "simulation_result", "production_approved", "native_result", "time_origin", "time_s", "selected_full_run_domain", "domain_selection", "viewer", "compatibility", "native_web", "shp_packages", "legacy_optional_artifacts", "security_exclusion", "database_status", "social_economy_status", "source_graph_file", "source_graph_sha256", "completeness"],
  "properties": {
    "format": {"const": "m1-output-bundle-v1"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^m1qa-[0-9a-f]{12}-[0-9a-f]{8}$"},
    "case_id": {"type": "string", "minLength": 1},
    "status": {"const": "QA_FIXTURE_READY_NOT_PRODUCTION"},
    "data_origin": {"const": "SYNTHETIC_SMALL_NATIVE_FIXTURE"},
    "qa_fixture": {"const": true},
    "live_solver_ran": {"const": false},
    "simulation_result": {"const": true},
    "production_approved": {"const": false},
    "native_result": {"type": "object", "required": ["file", "sha256", "source_path", "face_count", "node_count", "saved_frame_count", "grid_topology", "source_kind"], "properties": {"file": {"const": "result_native.nc"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_path": {"type": "string"}, "face_count": {"type": "integer", "minimum": 1}, "node_count": {"type": "integer", "minimum": 3}, "saved_frame_count": {"type": "integer", "minimum": 1}, "grid_topology": {"const": "native_triangular_mesh"}, "source_kind": {"type": "string"}}},
    "time_origin": {"type": ["string", "null"]},
    "time_s": {"type": "array", "items": {"type": "number"}},
    "selected_full_run_domain": {"const": "EXISTING_DOMAIN_MINUS_VALIDATED_SECURITY_EXCLUSION"},
    "domain_selection": {"type": "object", "required": ["choice", "source_geometry", "area_m2", "calculation", "m1_sample_relation"], "properties": {"choice": {"const": "EXISTING_DOMAIN_MINUS_VALIDATED_SECURITY_EXCLUSION"}, "source_geometry": {"type": "string"}, "area_m2": {"type": "null"}, "calculation": {"type": "string"}, "m1_sample_relation": {"type": "string"}}},
    "viewer": {"type": "object", "required": ["default_profile", "profiles"], "properties": {"default_profile": {"const": "native_web"}, "profiles": {"type": "object", "required": ["native_web", "compatibility_grid"], "properties": {"native_web": {"const": "native_web/manifest.json"}, "compatibility_grid": {"const": "nc2web/manifest.json"}}}}},
    "compatibility": {"type": "object", "required": ["profile", "file", "sha256", "grid_id_digest", "run_id", "mapping_file", "nc2web_v1", "stepjson_v1"], "properties": {"profile": {"const": "legacy-structured-grid-v1-derived-from-native-triangles"}, "file": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "grid_id_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "run_id": {"type": "string"}, "mapping_file": {"const": "compatibility_grid.json"}, "nc2web_v1": {"const": "nc2web/manifest.json"}, "stepjson_v1": {"const": "stepjson/index.json"}}},
    "native_web": {"type": "object", "required": ["manifest", "sha256"], "properties": {"manifest": {"const": "native_web/manifest.json"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "shp_packages": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "legacy_optional_artifacts": {"type": "object"},
    "security_exclusion": {"type": ["object", "null"]},
    "database_status": {"const": "DISABLED_NOT_REQUESTED"},
    "social_economy_status": {"const": "NOT_READ_NOT_REQUESTED"},
    "source_graph_file": {"const": "provenance/source_graph.json"},
    "source_graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "completeness": {"type": "string"}
  }
}
